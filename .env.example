# 环境变量模板 —— 这个文件可以提交到 GitHub
# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略）

# 阿里云百炼（通义万相文生图）
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# DeepSeek 官方文本模型（可选）
DEEPSEEK_API_KEY=your-deepseek-api-key

# 数据库（本机 MySQL）
DB_NAME=content_hub
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Django
SECRET_KEY=your-django-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# 生产部署时改为你的域名或服务器 IP，多个用逗号分隔
# ALLOWED_HOSTS=your-domain.com,your-server-ip
# CSRF_TRUSTED_ORIGINS=https://your-domain.com
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False

# Mock 降级开关（账户欠费/无网络时置 true，走本地模拟，不消耗额度）
USE_MOCK_AI=true
